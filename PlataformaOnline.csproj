<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Catálogo do jogo de arrancada vai junto no publish; os dados dos pilotos (Dados/) nunca. -->
    <Content Update="Drag\catalog.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Dados\**" />
    <None Remove="Dados\**" />
    <!-- Fontes .blend e scripts de conversão ficam fora do publish (o jogo usa wwwroot/arrancada/modelos). -->
    <Content Remove="Drag\CarrosBlender\**" />
    <None Remove="Drag\CarrosBlender\**" />
  </ItemGroup>

</Project>
